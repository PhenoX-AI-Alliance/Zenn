#!/usr/bin/env python3
import os
import glob
import datetime
import subprocess
import shutil
import requests
import json
import urllib.request
import urllib.parse
import re
import time

# Zenn Queue Processor
# Run via cron every 15 minutes. Picks one file from queue/, commits and pushes it.

ZENN_DIR = "/home/phenox/gemini-sandbox/TOAI_Generated/Zenn"
QUEUE_DIR = os.path.join(ZENN_DIR, "queue")
ARTICLES_DIR = os.path.join(ZENN_DIR, "articles")
IMAGES_DIR = os.path.join(ZENN_DIR, "images")
COUNT_FILE = os.path.join(ZENN_DIR, "deploy_count.txt")
MAX_DEPLOY_PER_DAY = 1

def get_github_token():
    try:
        with open("/home/phenox/gemini-sandbox/.env", "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith("GITHUB_ZENN_TOKEN="):
                    return line.strip().split("=", 1)[1].strip()
    except Exception:
        pass
    return None

def check_rate_limit():
    today = datetime.date.today().isoformat()
    count = 0
    if os.path.exists(COUNT_FILE):
        try:
            with open(COUNT_FILE, "r") as f:
                data = f.read().strip().split(",")
                if len(data) == 2 and data[0] == today:
                    count = int(data[1])
        except Exception:
            pass
            
    if count >= MAX_DEPLOY_PER_DAY:
        print(f"[{datetime.datetime.now().isoformat()}] 🛑 Daily deploy limit of {MAX_DEPLOY_PER_DAY} reached. Skipping.")
        return False
        
    return count, today

def extract_json(text):
    match = re.search(r'\{.*\}', text, re.DOTALL)
    if match:
        try:
            return json.loads(match.group(0))
        except:
            pass
    return None

def process_queue():
    limit_data = check_rate_limit()
    if not limit_data:
        return
        
    count, today = limit_data
    
    # --- Check staged_articles first ---
    staged_dir = os.path.join(ZENN_DIR, "staged_articles")
    if os.path.exists(staged_dir):
        staged_files = [f for f in os.listdir(staged_dir) if f.endswith('.md')]
        if staged_files:
            target_file = staged_files[0]
            src = os.path.join(staged_dir, target_file)
            dest_file = os.path.join(ARTICLES_DIR, target_file)
            shutil.move(src, dest_file)
            print(f"[{datetime.datetime.now().isoformat()}] Processing STAGED Zenn: {target_file}")
            
            token = get_github_token()
            if not token:
                print("Error: GITHUB_ZENN_TOKEN not found.")
                shutil.move(dest_file, src)
                return
            try:
                subprocess.run(["git", "config", "user.name", "TOAI Auto Publisher"], cwd=ZENN_DIR, check=True)
                subprocess.run(["git", "config", "user.email", "toai@phenox-ai-alliance.com"], cwd=ZENN_DIR, check=True)
                subprocess.run(["git", "add", f"articles/{target_file}"], cwd=ZENN_DIR, check=True)
                commit_msg = f"Auto-publish: Staged Zenn Article {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
                subprocess.run(["git", "commit", "-m", commit_msg], cwd=ZENN_DIR, check=True)
                remote_url = f"https://{token}@github.com/PhenoX-AI-Alliance/Zenn.git"
                subprocess.run(["git", "remote", "set-url", "origin", remote_url], cwd=ZENN_DIR, check=True)
                subprocess.run(["git", "config", "rebase.autoStash", "true"], cwd=ZENN_DIR, check=True)
                subprocess.run(["git", "pull", "--rebase", "origin", "main"], cwd=ZENN_DIR, check=True)
                subprocess.run(["git", "push", "origin", "main"], cwd=ZENN_DIR, check=True)
                print("✅ Successfully pushed STAGED article to GitHub.")
                with open(COUNT_FILE, "w") as f:
                    f.write(f"{today},{count + 1}")
            except subprocess.CalledProcessError as e:
                print(f"Git operation failed for staged article: {e}")
                print(f"🔄 Rolling back {target_file} to staged_articles...")
                subprocess.run(["git", "reset", "HEAD~1"], cwd=ZENN_DIR)
                shutil.move(dest_file, src)
            return
    # -----------------------------------
    
    queued_files = glob.glob(os.path.join(QUEUE_DIR, "*.md.queued"))
    if not queued_files:
        print(f"[{datetime.datetime.now().isoformat()}] Queue is empty.")
        return
        
    queued_files.sort(key=os.path.getctime)
    target_file = queued_files[0]
    filename = os.path.basename(target_file)
    if filename.endswith(".queued"):
        dest_filename = filename.replace(".queued", "")
    else:
        dest_filename = filename
        
    os.makedirs(ARTICLES_DIR, exist_ok=True)
    os.makedirs(IMAGES_DIR, exist_ok=True)
    # Ensure slug meets Zenn requirements (lowercase alphanumeric, hyphens, underscores, 12-50 chars)
    import re
    slug_base = dest_filename
    if slug_base.endswith('.md'):
        slug_base = slug_base[:-3]
    slug_base = slug_base.lower()
    slug_base = re.sub(r'[^a-z0-9\-_]', '_', slug_base)
    slug_base = re.sub(r'_+', '_', slug_base).strip('_')
    if len(slug_base) < 12:
        slug_base = (slug_base + "-article-post")[:12]
    if len(slug_base) > 50:
        slug_base = slug_base[:50].strip('_').strip('-')
    dest_filename = slug_base + ".md"
    dest_file = os.path.join(ZENN_DIR, "articles", dest_filename)
    
    print(f"[{datetime.datetime.now().isoformat()}] Processing Zenn: {filename}")
    
    with open(target_file, "r", encoding="utf-8") as f:
        content = f.read()
        
    # extract body from existing frontmatter if any
    body = content
    match = re.match(r'^(---\n.*?\n---)\n+(.*)$', content, flags=re.DOTALL)
    if match:
        body = match.group(2)
        
    print(f"[{datetime.datetime.now().isoformat()}] Sending to Ollama for JSON sublimation...")
    prompt = f"""あなたはプロの技術系Webライター兼編集者です。以下の原稿（AIによる一次ドラフト）を読み込み、Zennの読者が読んで「面白い！ためになる！」と感動するレベルの、高品質で魅力的な『日本語の技術ブログ記事』に推敲・昇華させてください。さらに、記事の末尾にはStripeやKo-fiなどの決済・支援リンクへの導線を自然な形で整えてください。

【重要ルール】
原稿内にStripeのAPIキー（sk_test_〜、sk_live_〜、whsec_〜等）やその他の「ダミーシークレットキー」が含まれている場合、GitHubのPush Protectionにブロックされるため、該当箇所は「伏せ字（XXXX等）」にするのではなく、その記述ごと跡形もなく完全に削除してください。

また、記事のテーマに合った「画像生成用プロンプト（英語）」と、「Zenn用トピックス（2〜5個のキーワードリスト）」も生成してください。

必ず以下のJSONフォーマットのみを出力してください（Markdownのバッククォート等は不要です）。
{{
    "title": "読者を惹きつける魅力的なタイトル（50文字以内）",
    "body": "記事本文（マークダウン形式、改行には\\nを使用）",
    "image_prompt": "english prompt for image generation, high quality, masterpiece",
    "topics": ["AI", "テクノロジー", "個人開発"]
}}

--- 元のテキスト ---
{body}
"""
    
    payload = {
        "model": "qwen3.6-35B-PhenoX:latest",
        "prompt": prompt,
        "stream": False
    }
    
    title = "TOAI Agent Report"
    body_content = body
    image_prompt = "futuristic artificial intelligence concept, clean design, minimalist"
    topics = ["AI", "テクノロジー"]
    
    try:
        response = requests.post("http://localhost:11434/api/generate", json=payload, timeout=3600)
        if response.status_code == 200:
            raw_res = response.json().get("response", "")
            parsed = extract_json(raw_res)
            if parsed:
                title = parsed.get("title", title)[:50]
                body_content = parsed.get("body", body_content)
                image_prompt = parsed.get("image_prompt", image_prompt)
                topics = parsed.get("topics", topics)
                print("✅ Ollama JSON rewrite successful.")
            else:
                print("⚠️ Failed to parse JSON from Ollama.")
        else:
            print(f"⚠️ Ollama rewrite failed (HTTP {response.status_code}).")
    except Exception as e:
        print(f"⚠️ Ollama rewrite error: {e}.")

    # --- Link Sanitization ---
    body_content = re.sub(r'https://ko-fi\.com/[a-zA-Z0-9_-]+', 'https://ko-fi.com/phenox_noc2', body_content)
    body_content = re.sub(r'https://(?:buy|checkout)\.stripe\.com/(?!.*cs_(live|test)_)[a-zA-Z0-9_/-]+', 'https://ko-fi.com/phenox_noc2', body_content)
    body_content = re.sub(r'\[([^\]]*?)Stripe([^\]]*?)\]\(https://ko-fi\.com', r'[\1Ko-fi\2](https://ko-fi.com', body_content)
    # --- Secret Scrubbing ---
    body_content = re.sub(r'(sk_test|sk_live|whsec)_[a-zA-Z0-9X]+', 'YOUR_STRIPE_KEY_REMOVED_FOR_SECURITY', body_content)
    
    # --- Image Generation ---
    print(f"🎨 Generating Zenn eyecatch image using Imagen/Pollinations...")
    image_basename = f"eyecatch_{dest_filename.replace('.md', '')}_{int(time.time())}.png"
    header_img_path = os.path.join(IMAGES_DIR, image_basename)
    image_frontmatter = ""
    
    try:
        import sys
        sandbox_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
        if sandbox_dir not in sys.path:
            sys.path.insert(0, sandbox_dir)
        import toai_charter
        
        image_bytes = toai_charter.generate_image(image_prompt, width=1200, height=630)
        
        if image_bytes:
            with open(header_img_path, 'wb') as out_f:
                out_f.write(image_bytes)
            print(f"✅ Image generated and saved to {header_img_path}")
            image_frontmatter = f'eyecatch: "/images/{image_basename}"\n'
        else:
            print(f"⚠️ Failed to generate image.")
    except Exception as e:
        print(f"⚠️ Failed to generate image: {e}")

    # Build Frontmatter
    emoji = "🤖"
    type_str = "tech"
    published = "true"
    
    topics_str = "[" + ", ".join([f'"{t}"' for t in topics]) + "]"
    
    new_frontmatter = f"""---
title: "{title}"
emoji: "{emoji}"
type: "{type_str}"
topics: {topics_str}
published: {published}
{image_frontmatter}---

"""
    
    content = new_frontmatter + body_content
    
    # Save the polished content directly to the articles directory
    with open(dest_file, "w", encoding="utf-8") as f:
        f.write(content)
        
    os.remove(target_file)
    
    # Publish
    token = get_github_token()
    if not token:
        print("Error: GITHUB_ZENN_TOKEN not found.")
        shutil.move(dest_file, target_file)
        return
        
    try:
        subprocess.run(["git", "config", "user.name", "TOAI Auto Publisher"], cwd=ZENN_DIR, check=True)
        subprocess.run(["git", "config", "user.email", "toai@phenox-ai-alliance.com"], cwd=ZENN_DIR, check=True)
        
        # --- Pre-flight Validation (FrontMatter Check) ---
        articles_dir = os.path.join(ZENN_DIR, "articles")
        for md_file in os.listdir(articles_dir):
            if md_file.endswith(".md"):
                full_path = os.path.join(articles_dir, md_file)
                try:
                    with open(full_path, "r", encoding="utf-8") as f:
                        first_line = f.readline().strip()
                    if first_line != "---":
                        print(f"⚠️ Removing invalid article (Missing FrontMatter): {md_file}")
                        subprocess.run(["git", "rm", "-f", f"articles/{md_file}"], cwd=ZENN_DIR, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        if os.path.exists(full_path):
                            os.remove(full_path)
                except Exception as ex:
                    pass
        
        subprocess.run(["git", "add", f"articles/{dest_filename}"], cwd=ZENN_DIR, check=True)
        if image_frontmatter:
            subprocess.run(["git", "add", f"images/{image_basename}"], cwd=ZENN_DIR, check=True)
            
        commit_msg = f"Auto-publish: Zenn Article {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
        subprocess.run(["git", "commit", "-m", commit_msg], cwd=ZENN_DIR, check=True)
        
        remote_url = f"https://{token}@github.com/PhenoX-AI-Alliance/Zenn.git"
        subprocess.run(["git", "remote", "set-url", "origin", remote_url], cwd=ZENN_DIR, check=True)
        
        # Pull remote changes first to prevent 'rejected (fetch first)' errors
        # rebase時にunstagedな変更によるエラーを防ぐため autoStash を有効化
        subprocess.run(["git", "config", "rebase.autoStash", "true"], cwd=ZENN_DIR, check=True)
        subprocess.run(["git", "pull", "--rebase", "origin", "main"], cwd=ZENN_DIR, check=True)
        
        subprocess.run(["git", "push", "origin", "main"], cwd=ZENN_DIR, check=True)
        print("✅ Successfully pushed to GitHub.")
        
        with open(COUNT_FILE, "w") as f:
            f.write(f"{today},{count + 1}")
            
    except subprocess.CalledProcessError as e:
        print(f"Git operation failed: {e}")
        print(f"🔄 Rolling back {dest_filename} to staged_articles...")
        subprocess.run(["git", "reset", "HEAD~1"], cwd=ZENN_DIR)
        staged_dir = os.path.join(ZENN_DIR, "staged_articles")
        os.makedirs(staged_dir, exist_ok=True)
        if os.path.exists(dest_file):
            shutil.move(dest_file, os.path.join(staged_dir, dest_filename))

if __name__ == "__main__":
    process_queue()
